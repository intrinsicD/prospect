{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prospect.invalid/schemas/wm002/q1-audit-output.schema.json",
  "title": "WM-002 Q1 independent audit output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocol_version",
    "run_id",
    "attempt_id",
    "protocol_sha256",
    "implementation_sha256",
    "entry_qualification_sha256",
    "prospective_review_sha256",
    "q0_report_sha256",
    "salt_commitment_sha256",
    "attempt_marker_sha256",
    "worker_capability_sha256",
    "raw_trace_sha256",
    "private_audit_sha256",
    "checkpoint_index_sha256",
    "checkpoint_frames_sha256",
    "restored_trace_sha256",
    "producer_aggregate_sha256",
    "claim_eligible",
    "formal_authorized",
    "independent_recomputation",
    "counts",
    "comparisons",
    "gates",
    "accepted_prefix",
    "passed",
    "verdict",
    "scope_limitations"
  ],
  "properties": {
    "schema": {
      "const": "prospect.wm002.active-acquisition.q1-independent-audit.v2"
    },
    "protocol_version": {
      "const": "0.3.0-q1"
    },
    "run_id": {
      "$ref": "#/$defs/run_id"
    },
    "attempt_id": {
      "$ref": "#/$defs/attempt_id"
    },
    "protocol_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "implementation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "entry_qualification_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "prospective_review_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "q0_report_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "salt_commitment_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "attempt_marker_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "worker_capability_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "raw_trace_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "private_audit_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "checkpoint_index_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "checkpoint_frames_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "restored_trace_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "producer_aggregate_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "claim_eligible": {
      "const": false
    },
    "formal_authorized": {
      "const": false
    },
    "independent_recomputation": {
      "const": true
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisition_updates",
        "arms",
        "checkpoint_frames",
        "environment_steps",
        "episodes",
        "masters",
        "private_rows",
        "raw_rows",
        "restored_rows",
        "terminal_updates",
        "transitions"
      ],
      "properties": {
        "acquisition_updates": {
          "type": "integer",
          "minimum": 0
        },
        "arms": {
          "type": "integer",
          "minimum": 0
        },
        "checkpoint_frames": {
          "type": "integer",
          "minimum": 0
        },
        "environment_steps": {
          "type": "integer",
          "minimum": 0
        },
        "episodes": {
          "type": "integer",
          "minimum": 0
        },
        "masters": {
          "type": "integer",
          "minimum": 0
        },
        "private_rows": {
          "type": "integer",
          "minimum": 0
        },
        "raw_rows": {
          "type": "integer",
          "minimum": 0
        },
        "restored_rows": {
          "type": "integer",
          "minimum": 0
        },
        "terminal_updates": {
          "type": "integer",
          "minimum": 0
        },
        "transitions": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "comparisons": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_arm",
          "master_differences",
          "mean_difference",
          "ci95_lower",
          "ci95_upper",
          "passed"
        ],
        "properties": {
          "control_arm": {
            "enum": [
              "goal_only",
              "raw_observation_entropy",
              "eig_only",
              "shuffled_information",
              "uniform_random"
            ]
          },
          "master_differences": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          },
          "mean_difference": {
            "type": "number"
          },
          "ci95_lower": {
            "type": "number"
          },
          "ci95_upper": {
            "type": "number"
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate",
          "passed",
          "violations"
        ],
        "properties": {
          "gate": {
            "enum": [
              "Q1-K0",
              "Q1-K1",
              "Q1-K2",
              "Q1-K3",
              "Q1-K4",
              "Q1-K5"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "violations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "accepted_prefix": {
      "type": "array",
      "items": {
        "enum": [
          "Q1-K0",
          "Q1-K1",
          "Q1-K2",
          "Q1-K3",
          "Q1-K4",
          "Q1-K5"
        ]
      }
    },
    "passed": {
      "type": "boolean"
    },
    "verdict": {
      "type": "string",
      "minLength": 1
    },
    "scope_limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^wm002-q1-[0-9a-f]{64}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^wm002-q1-[0-9a-f]{64}-attempt-0001$"
    }
  }
}
