{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prospect.invalid/schemas/wm002/q1-checkpoint-frame.schema.json",
  "title": "WM-002 Q1 checkpoint frame index row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocol_version",
    "run_id",
    "attempt_id",
    "entry_qualification_sha256",
    "master",
    "arm",
    "episode",
    "frame_offset",
    "frame_header_bytes",
    "frame_length",
    "checkpoint_sha256",
    "component_sha256"
  ],
  "properties": {
    "schema": {
      "const": "prospect.wm002.active-acquisition.q1-checkpoint-frame.v1"
    },
    "protocol_version": {
      "const": "0.3.0-q1"
    },
    "run_id": {
      "$ref": "#/$defs/run_id"
    },
    "attempt_id": {
      "$ref": "#/$defs/attempt_id"
    },
    "entry_qualification_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "master": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "arm": {
      "enum": [
        "prospect_expected_return",
        "independent_fraction_oracle",
        "goal_only",
        "raw_observation_entropy",
        "eig_only",
        "shuffled_information",
        "uniform_random"
      ]
    },
    "episode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1023
    },
    "frame_offset": {
      "type": "integer",
      "minimum": 0
    },
    "frame_header_bytes": {
      "const": 8
    },
    "frame_length": {
      "type": "integer",
      "minimum": 1
    },
    "checkpoint_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "component_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_custody",
        "episode_accumulator",
        "identity_counter",
        "posterior_model",
        "qualification_binding"
      ],
      "properties": {
        "domain_custody": {
          "$ref": "#/$defs/sha256"
        },
        "episode_accumulator": {
          "$ref": "#/$defs/sha256"
        },
        "identity_counter": {
          "$ref": "#/$defs/sha256"
        },
        "posterior_model": {
          "$ref": "#/$defs/sha256"
        },
        "qualification_binding": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^wm002-q1-[0-9a-f]{64}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^wm002-q1-[0-9a-f]{64}-attempt-0001$"
    }
  }
}
