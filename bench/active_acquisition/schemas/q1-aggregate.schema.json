{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prospect.invalid/schemas/wm002/q1-aggregate.schema.json",
  "title": "WM-002 Q1 producer aggregate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocol_version",
    "run_id",
    "attempt_id",
    "protocol_sha256",
    "implementation_sha256",
    "entry_qualification_sha256",
    "q0_report_sha256",
    "salt_commitment_sha256",
    "claim_eligible",
    "formal_authorized",
    "producer_analysis_authoritative",
    "counts",
    "arm_means",
    "comparisons"
  ],
  "properties": {
    "schema": {
      "const": "prospect.wm002.active-acquisition.q1-aggregate.v1"
    },
    "protocol_version": {
      "const": "0.3.0-q1"
    },
    "run_id": {
      "$ref": "#/$defs/run_id"
    },
    "attempt_id": {
      "$ref": "#/$defs/attempt_id"
    },
    "protocol_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "implementation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "entry_qualification_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "q0_report_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "salt_commitment_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "claim_eligible": {
      "const": false
    },
    "formal_authorized": {
      "const": false
    },
    "producer_analysis_authoritative": {
      "const": false
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "masters",
        "arms",
        "episodes",
        "environment_steps",
        "transitions",
        "acquisition_updates",
        "terminal_updates",
        "checkpoints",
        "restores"
      ],
      "properties": {
        "masters": {
          "const": 4
        },
        "arms": {
          "const": 7
        },
        "episodes": {
          "const": 28672
        },
        "environment_steps": {
          "const": 57344
        },
        "transitions": {
          "const": 57344
        },
        "acquisition_updates": {
          "const": 28672
        },
        "terminal_updates": {
          "const": 0
        },
        "checkpoints": {
          "const": 28672
        },
        "restores": {
          "const": 28672
        }
      }
    },
    "arm_means": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "master",
          "arm",
          "episode_count",
          "mean_return"
        ],
        "properties": {
          "master": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "arm": {
            "$ref": "#/$defs/arm"
          },
          "episode_count": {
            "const": 1024
          },
          "mean_return": {
            "type": "number"
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_arm",
          "master_differences",
          "mean_difference",
          "ci95_lower",
          "ci95_upper"
        ],
        "properties": {
          "control_arm": {
            "enum": [
              "goal_only",
              "raw_observation_entropy",
              "eig_only",
              "shuffled_information",
              "uniform_random"
            ]
          },
          "master_differences": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          },
          "mean_difference": {
            "type": "number"
          },
          "ci95_lower": {
            "type": "number"
          },
          "ci95_upper": {
            "type": "number"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "arm": {
      "enum": [
        "prospect_expected_return",
        "independent_fraction_oracle",
        "goal_only",
        "raw_observation_entropy",
        "eig_only",
        "shuffled_information",
        "uniform_random"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^wm002-q1-[0-9a-f]{64}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^wm002-q1-[0-9a-f]{64}-attempt-0001$"
    }
  }
}
